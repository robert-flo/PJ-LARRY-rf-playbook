#!/bin/bash
# PJ-LARRY guard + adapter. Replaces Omarchy's mise wrapper, which installs Claude Code on first call.
# The harness is cursor-agent: interactive `claude` is refused. Headless `claude --print` calls from
# nixfredOS / LMF4 (Inference.ts, SessionExtract, ConfigEval, mem loa/dump) are answered by
# `cursor-agent -p --mode ask` instead, with the same stdin/stdout contract (text or JSON envelope).
# Adapter calls run under a private HOME that only links the Cursor login, so ~/.cursor/hooks.json and
# ~/.claude/settings.json hooks don't fire and their transcripts stay out of ~/.cursor/projects.
# Model: CLAUDE_ADAPTER_MODEL (default composer-2.5, cheap and fast); the requested Claude model is ignored.
# Every call is logged with its caller. Restore Omarchy's wrapper with: omarchy-mise-install claude
log="${XDG_STATE_HOME:-$HOME/.local/state}/claude-guard.log"
mkdir -p "${log%/*}"
caller=$(tr '\0' ' ' </proc/$PPID/cmdline 2>/dev/null | cut -c1-300)
logline() { printf '%s\t%s\targs=%s\tcaller=%s\n' "$(date -Is)" "$1" "$(printf '%s ' "${@:2}" | tr '\n' ' ' | cut -c1-160)" "$caller" >>"$log"; }

print=0
for a in "$@"; do [[ $a == --print || $a == -p ]] && print=1; done
if ((!print)); then
  logline refused "$@"
  echo "claude: disabled on this machine (harness is cursor-agent; see PJ-LARRY-rf-playbook 10.4)" >&2
  exit 127
fi

format=text sys="" prompt=""
while (($#)); do
  case $1 in
    --output-format) format=$2; shift 2 ;;
    --system-prompt|--append-system-prompt) sys+="$2"$'\n'; shift 2 ;;
    --system-prompt-file|--append-system-prompt-file) sys+="$(<"$2")"$'\n'; shift 2 ;;
    --model|--effort|--tools|--allowedTools|--allowed-tools|--disallowedTools|--setting-sources|--max-turns|--permission-mode|--fallback-model|--session-id|--input-format|--mcp-config|--settings|--add-dir)
      shift 2 ;;
    -p|--print|--verbose|--exclude-dynamic-system-prompt-sections|--dangerously-skip-permissions|--no-session-persistence|--strict-mcp-config)
      shift ;;
    --*) shift ;;
    *) prompt+="$1"$'\n'; shift ;;
  esac
done
[[ -t 0 ]] || prompt+="$(cat)"
logline adapter --output-format "$format" --model "${CLAUDE_ADAPTER_MODEL:-composer-2.5}"

agent=$(command -v cursor-agent) || { echo "claude adapter: cursor-agent not found" >&2; exit 127; }
real_auth="${XDG_CONFIG_HOME:-$HOME/.config}/cursor/auth.json"
[[ -r $real_auth ]] || { echo "claude adapter: no Cursor login ($real_auth); run cursor-agent login" >&2; exit 1; }
ahome="${XDG_CACHE_HOME:-$HOME/.cache}/claude-adapter/home"
mkdir -p "$ahome/.config/cursor" "$ahome/ws"
ln -sfn "$real_auth" "$ahome/.config/cursor/auth.json"

input=$prompt
[[ -n $sys ]] && input="<instructions>
${sys}</instructions>

${prompt}"
out_format=text; [[ $format == json ]] && out_format=json
cd "$ahome/ws" || exit 1
printf '%s' "$input" | env -u XDG_CONFIG_HOME HOME="$ahome" "$agent" -p --trust --mode ask \
  --model "${CLAUDE_ADAPTER_MODEL:-composer-2.5}" --output-format "$out_format"
