
# Forever repos (playbook Chapter 7): dotbare manages sura-home in ~/.cfg; wgup previews gup
export DOTBARE_DIR="$HOME/.cfg" DOTBARE_TREE="$HOME"
alias wgup='gup -n'
# homegup: commit+push sura-home on master (one commit per run; .gitignore drops session noise)
alias homegup='GIT_DIR="$DOTBARE_DIR" GIT_WORK_TREE="$DOTBARE_TREE" gup'
alias whomegup='homegup -n'
